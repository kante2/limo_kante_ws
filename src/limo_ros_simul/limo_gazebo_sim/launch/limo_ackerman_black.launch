<?xml version="1.0"?>
<launch>

  <!-- ===== Args ===== -->
  <arg name="robot_namespace" default="limo"/>
  <!-- <arg name="world_name" default="$(find limo_gazebo_sim)/worlds/blacktrack_light.world"/> -->
  <arg name="world_name" default="$(find limo_gazebo_sim)/worlds/track_inha/track_inha.world"/>
  <arg name="gui" default="true"/>
  <arg name="x"   default="0.0"/>
  <arg name="y"   default="0.0"/>
  <arg name="z"   default="0.00"/>
  <arg name="yaw" default="0.0"/>

  <!-- ===== Gazebo (pause로 먼저 띄우기) ===== -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="paused" value="true"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <!-- Gazebo 서비스가 실제로 뜰 때까지 대기 -->
  <node pkg="rosservice" type="rosservice" name="wait_gz" output="screen"
        args="call --wait /gazebo/get_world_properties '{}'" />

  <!-- ===== URDF 주입 ===== -->
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find limo_description)/urdf/limo_ackerman.xacro'
                  robot_namespace:=$(arg robot_namespace)"/>

  <!-- ===== PID 파라미터 로드 (플러그인 기대 NS와 일치) ===== -->
  <!-- pids.yaml 안에는 휠 조인트명 키: {p,i,d,i_clamp} 형태로만 두세요 -->
  <rosparam command="load"
            file="$(find limo_gazebo_sim)/config/pids.yaml"
            ns="limo/gazebo_ros_control/pid_gains"/>

  <!-- Ackerman 컨트롤러 등 (필요 시) -->
  <rosparam command="load"
            file="$(find limo_gazebo_sim)/config/limo_ackerman_control.yaml"
            ns="limo"/>

  <!-- 기존 동일 이름 모델 삭제 (서비스 준비 후 안전하게) -->
  <node pkg="rosservice" type="rosservice" name="delete_old_limo" output="screen"
        args="call /gazebo/delete_model '{model_name: &quot;$(arg robot_namespace)&quot;}'" />

  <!-- ===== 스폰 ===== -->
  <node name="spawn_limo_model" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf
              -param robot_description
              -model $(arg robot_namespace)
              -x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw)"/>

  <!-- ===== Controllers & RSP ===== -->
  <node name="controller_spawner"
        pkg="controller_manager" type="spawner" output="screen" respawn="false"
        args="limo_state_controller
              limo_fl_steering_hinge_controller
              limo_fr_steering_hinge_controller"/>

  <node name="robot_state_publisher"
        pkg="robot_state_publisher" type="robot_state_publisher"/>

</launch>
