<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <!-- Sun -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ===== 트랙 바닥(plane + PNG 텍스처) ===== -->
    <model name="track_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="link">
        <!-- 충돌면 -->
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size> <!-- 트랙 실제 크기로 조정 -->
            </plane>
          </geometry>
        </collision>

        <!-- 시각화: PNG 텍스처 적용 -->
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size> <!-- 위와 동일 -->
            </plane>
          </geometry>
          <material>
            <script>
              <!-- .material/.png 위치 알려주기 -->
              <uri>file://materials/scripts</uri>
              <uri>file://materials/textures</uri>
              <name>Gazebo/BlackTrack</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    <!-- ======================================= -->

    <physics type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>
  </world>
</sdf>
