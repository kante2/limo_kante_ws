    <!-- ⚫️ 바닥: 충돌 plane + 시각화 + 물리 파라미터(마찰/접촉) -->
    <link name="floor_link">
      <!-- world 원점에 위치 -->
      <pose>0 0 0 0 0 0</pose>

      <!-- 물리 충돌: 충분히 큰 평면 -->
      <collision name="floor_collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <!-- 마찰/접촉 튜닝 (ODE) -->
        <surface>
          <friction>
            <ode>
              <!-- 종방향/횡방향 마찰계수 (아스팔트 느낌) -->
              <mu>1.0</mu>
              <mu2>1.0</mu2>
              <!-- 속도 의존 항(미끄럼 방지 약간) -->
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <!-- 관통 방지/안정화 -->
              <kp>1e6</kp>
              <kd>1e3</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.2</max_vel>
            </ode>
          </contact>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>1e3</threshold>
          </bounce>
        </surface>
      </collision>

      <!-- 시각화: 살짝 어두운 아스팔트색, z-파이팅 방지 위해 아주 미세하게 띄움 -->
      <visual name="floor_visual">
        <pose>0 0 0.0005 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <material>
          <!-- 진한 회색(아스팔트풍) -->
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>
