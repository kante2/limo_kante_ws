# Jetson Nano (L4T r32.7.1, CUDA 10.2) + ROS Noetic
FROM dustynv/ros:noetic-ros-base-l4t-r32.7.1

ENV DEBIAN_FRONTEND=noninteractive

# 개발 도구 + rosdep + 카메라/TF 등 ROS 의존 패키지 + libuvc
RUN apt-get update && apt-get install -y \
    build-essential cmake git python3-pip python3-rosdep \
    ros-noetic-catkin \
    ros-noetic-camera-info-manager \
    ros-noetic-image-transport \
    ros-noetic-image-geometry \
    ros-noetic-cv-bridge \
    ros-noetic-nodelet \
    ros-noetic-diagnostic-updater \
    ros-noetic-ddynamic-reconfigure \
    ros-noetic-tf \
    ros-noetic-tf-conversions \
    ros-noetic-tf2-ros \
    ros-noetic-tf2-geometry-msgs \
    libusb-1.0-0-dev \
    libudev-dev \
    libv4l-dev \
    libuvc-dev \
 && rm -rf /var/lib/apt/lists/*

# rosdep 초기화(여러 번 실행돼도 무시)
RUN rosdep init || true

# 워크스페이스 초기화/의존 설치/SDK 설치를 담당하는 스크립트
COPY init_ws.sh /usr/local/bin/init_ws.sh
RUN chmod +x /usr/local/bin/init_ws.sh

# 편의: bash 기본
SHELL ["/bin/bash", "-lc"]
